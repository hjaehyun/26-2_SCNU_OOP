import java.util.Scanner;
public class Main{
    public static void main(String[] args){
        Scanner s = new Scanner(System.in);
        int[] n = new int[10];
        int even = 0;
        int odd = 0;
        for(int i=0;i<10;i++){
            n[i]=s.nextInt();
            if( (i+1)%2==0){
                
                even = even + n[i];
            } else{
                odd = odd + n[i];
            }
        }
        System.out.println("odd : " + odd);
        System.out.println("even : " + even);
    }
}
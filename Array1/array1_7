import java.util.Scanner;
public class Main{
    public static void main(String[] args){
        Scanner s = new Scanner(System.in);
        int[] arr1 = new int[100];
        int max = -999;
        int min = 999;
        for(int i = 0;i<100;i++){
            arr1[i] = s.nextInt();
            if(arr1[i]==999){
                break;
            }
            if(arr1[i] > max){
                max = arr1[i];
            }
            if(arr1[i] < min){
                min = arr1[i];
            }
        }
        System.out.println("max : "+ max);
        System.out.println("min : "+ min);
    }
}
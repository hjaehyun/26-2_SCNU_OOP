import java.util.Scanner;
public class Main{
    public static void main(String[] args){
        Scanner s = new Scanner(System.in);
        double[] n = new double[6];
        double avg = 0;
        double sum = 0;
        for(int i=0;i<6;i++){
            n[i] = s.nextDouble();
            sum += n[i];
        }
        avg = sum / n.length;
        System.out.printf("%.1f",avg);
    }
}